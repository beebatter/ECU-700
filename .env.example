# Copy this file to .env and fill in local-only settings.
# Do not commit .env.

# DeepSeek-compatible chat endpoint. DeepSeek currently provides chat models;
# this project uses sentence-transformers locally for embeddings.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_THINKING=false

# Agentic planning / generation. With an API key, the app uses LLM planning,
# LLM tool planning, and grounded LLM answer synthesis by default.
ME_USE_LLM_PLANNER=true
ME_USE_LLM_TOOL_PLANNER=true
ME_USE_LLM_ANSWER=true
ME_FORCE_LLM=true

# Local embedding retrieval.
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional conversation memory. CLI enables memory by default; programmatic
# ECUAgent usage remains stateless unless ME_MEMORY_ENABLED=true is set or
# memory_enabled=True is passed explicitly.
ME_MEMORY_ENABLED=false
ME_MEMORY_DB_PATH=.me_engineering_memory.sqlite

# Human-in-the-loop review queue for low-confidence answers.
ME_HITL_ENABLED=true
ME_HITL_CONFIDENCE_THRESHOLD=0.75
ME_REVIEW_QUEUE_PATH=review_queue.jsonl

# Structured JSONL logs for human/AI monitoring.
ME_AGENT_LOG_ENABLED=true
ME_AGENT_LOG_PATH=logs/agent_events.jsonl
ME_AGENT_LOG_INCLUDE_TRACE=true
ME_AGENT_LOG_LOW_CONFIDENCE_THRESHOLD=0.75
ME_AGENT_LOG_SLOW_SECONDS=10

# Optional Databricks compatibility path.
DATABRICKS_LLM_ENDPOINT=
